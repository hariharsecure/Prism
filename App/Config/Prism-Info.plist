<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Prism</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Prism can capture system and per-app audio as sources.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Prism uses Bluetooth to discover nearby iPhones and iPads so you can pair them faster over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_prism._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Prism captures video from cameras you add as sources.</string>
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Prism discovers and receives video from your iPhones and iPads on the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Prism captures audio from microphones you add as sources.</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>Prism installs a camera extension so other apps can use Prism's program output as a camera.</string>
</dict>
</plist>

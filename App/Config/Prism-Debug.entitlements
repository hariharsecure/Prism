<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug/ad-hoc entitlements: hardened-runtime resource access only.
	     com.apple.developer.system-extension.install is intentionally ABSENT —
	     it is a restricted entitlement; an ad-hoc-signed binary carrying it is
	     killed by AMFI at launch. Release uses Config/Prism.entitlements. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
